#!/usr/bin/env python3
"""Run every gadget collector and print their entries as one JSON array.

Collectors are executables in the plugin's collectors.d/ and in
~/.config/omarchy/omnisystem-center/collectors.d/ (and Gadget Batteries'
collectors.d/, same format). Each prints a JSON array in the
external format (see README.md) and exits. A collector that fails, times out
or prints something else is skipped, so one broken script never hides the rest.

OmniSystem Center's service calls this once a minute; a lock plus a short-lived
cache in ~/.cache/omnisystem-center/collectors.json keep two runs from overlapping.
While the panel is open (OMNISYSTEM_CENTER_PANEL_OPEN=1, passed on to the
collectors) the cache is kept much shorter so the panel shows fresh levels.
"""
import fcntl
import json
import os
import subprocess
import sys
import time

TIMEOUT = 20
FRESH = 45
FRESH_PANEL_OPEN = 8
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "omnisystem-center")
OUTPUT = os.path.join(CACHE, "collectors.json")
HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
# The plugin's own collectors, the user's, and those written for Gadget
# Batteries (same format), so existing scripts keep working.
DIRS = [
    os.path.join(HERE, "collectors.d"),
    os.path.join(CONFIG, "omarchy", "omnisystem-center", "collectors.d"),
    os.path.join(CONFIG, "omarchy", "gadget-batteries", "collectors.d"),
]


def collectors():
    for directory in DIRS:
        try:
            names = sorted(os.listdir(directory))
        except OSError:
            continue
        for name in names:
            path = os.path.join(directory, name)
            if os.path.isfile(path) and os.access(path, os.X_OK):
                yield path


def run(path):
    try:
        result = subprocess.run([path], capture_output=True, text=True, timeout=TIMEOUT)
        data = json.loads(result.stdout or "[]")
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return []
    return [entry for entry in data if isinstance(entry, dict)] if isinstance(data, list) else []


os.makedirs(CACHE, exist_ok=True)
with open(os.path.join(CACHE, "collectors.lock"), "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        fresh = FRESH_PANEL_OPEN if os.environ.get("OMNISYSTEM_CENTER_PANEL_OPEN") == "1" else FRESH
        if time.time() - os.path.getmtime(OUTPUT) < fresh:
            with open(OUTPUT) as handle:
                sys.stdout.write(handle.read())
            sys.exit(0)
    except OSError:
        pass
    entries = []
    for path in collectors():
        entries.extend(run(path))
    text = json.dumps(entries) + "\n"
    with open(OUTPUT + ".tmp", "w") as handle:
        handle.write(text)
    os.replace(OUTPUT + ".tmp", OUTPUT)
    sys.stdout.write(text)
